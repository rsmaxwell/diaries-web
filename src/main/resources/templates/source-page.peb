{% extends "layouts/base.peb" %}
{% block content %}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="{{ diariesUrl }}">Diaries</a> / <a href="{{ diary.url }}">{{ diary.name }}</a>
</nav>
<header class="page-heading{% if not hasFragments %} source-page-heading--untranscribed{% endif %}">
  {% if hasFragments %}<p class="eyebrow">Original diary page</p>{% endif %}
  <h1>{{ page.name }}</h1>
</header>

<div class="source-layout" data-source-page>
  <figure class="source-image">
    <svg viewBox="0 0 {{ page.width }} {{ page.height }}" role="img" aria-labelledby="source-title source-description">
      <title id="source-title">Original page {{ page.name }}</title>
      <desc id="source-description">The scanned diary page. The selected transcript region is highlighted.</desc>
      <image href="{{ page.pageImageUrl }}" width="{{ page.width }}" height="{{ page.height }}"></image>
      {% for fragment in fragments %}
      {% if fragment.hasMarquee %}
      <a class="marquee-link"
         data-marquee-fragment="{{ fragment.id }}"
         href="#{{ fragment.anchor }}"
         aria-label="Read transcript for {{ fragment.date }}">
        <rect class="marquee" x="{{ fragment.x }}" y="{{ fragment.y }}" width="{{ fragment.width }}" height="{{ fragment.height }}"></rect>
      </a>
      {% endif %}
      {% endfor %}
    </svg>
    <figcaption>If the scan does not load, use the transcript links below.</figcaption>
  </figure>

  <section aria-labelledby="transcript-heading">
    <h2 id="transcript-heading">Transcript</h2>
    {% if hasFragments %}
      {% for fragment in fragments %}
      <article class="fragment"
               id="{{ fragment.anchor }}"
               data-transcript-fragment="{{ fragment.id }}"
               data-fragment-type="{{ fragment.fragmentType }}" data-media-state="{{ fragment.mediaState }}">
        <div class="fragment__heading">
          <h3><a href="{{ fragment.monthUrl }}">{{ fragment.date }}</a></h3>
          <button class="fragment__selector"
                  type="button"
                  data-fragment-selector="{{ fragment.id }}"
                  aria-pressed="false">{% if fragment.hasMarquee %}Show on original page{% elseif fragment.fragmentType == "IMAGE" %}Select image fragment{% else %}Select fragment{% endif %}</button>
        </div>
        <div class="fragment__content">{{ fragment.html | raw }}</div>
        {% if fragment.mediaUrl %}
        <figure class="fragment-media" data-fragment-media="{{ fragment.id }}">
          <img class="fragment-media__image" src="{{ fragment.mediaUrl }}" alt="{{ fragment.mediaAltText }}"
               width="{{ fragment.mediaWidth }}" height="{{ fragment.mediaHeight }}" loading="lazy" decoding="async">
          {% if fragment.mediaCaption %}<figcaption class="fragment-media__caption">{{ fragment.mediaCaption }}</figcaption>{% endif %}
          <p class="fragment-media__fallback"><a href="{{ fragment.mediaUrl }}">Open image directly</a></p>
        </figure>
        {% else %}
          {% if fragment.mediaUnavailableText %}<p class="fragment-media__status" data-media-state="{{ fragment.mediaState }}">{{ fragment.mediaUnavailableText }}</p>{% endif %}
        {% endif %}
      </article>
      {% endfor %}
    {% else %}
      <p>No published transcript is linked to this source page.</p>
    {% endif %}
  </section>
</div>
{% endblock %}
