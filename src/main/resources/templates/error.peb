{% extends "layouts/base.peb" %}
{% block content %}
<header class="page-heading">
  <p class="eyebrow">Error {{ statusCode }}</p>
  <h1>{{ pageTitle }}</h1>
  <p>{{ message }}</p>
  {% if requestId %}<p class="request-id">Request reference: {{ requestId }}</p>{% endif %}
  <p><a href="{{ homeUrl }}">Return to the diary index</a></p>
</header>
{% endblock %}
