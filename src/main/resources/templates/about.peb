{% extends "layouts/base.peb" %}
{% block content %}
<header class="page-heading">
  <p class="eyebrow">About</p>
  <h1>About {{ siteTitle }}</h1>
  <p>{{ siteDescription }}</p>
</header>
<section>
  <h2>Service information</h2>
  <dl class="details">
    <div><dt>Application</dt><dd>{{ build.name }}</dd></div>
    <div><dt>Version</dt><dd>{{ build.version }}</dd></div>
    <div><dt>Build</dt><dd>{{ build.buildId }}</dd></div>
    <div><dt>Build date</dt><dd>{{ build.buildDate }}</dd></div>
    <div><dt>Projection</dt><dd>{{ projection.status }}</dd></div>
    <div><dt>Snapshot generation</dt><dd>{{ projection.generation }}</dd></div>
  </dl>
</section>
{% endblock %}
